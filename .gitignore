# 运行产物
__pycache__/
*.py[cod]
*.egg-info/

# 实例运行时配置：由 Runner 依据 plugin.py 的 config_model 生成，会存 API Key，
# 不随仓库提交（官方目录约定要求忽略）。
/config.toml

# 宿主生成的插件运行数据：config_back 里是 config.toml 的历史备份（含明文 Key），
# data/ 是插件用户数据目录。
config_back/
data/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
